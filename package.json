{
  "name": "durable-migrations",
  "version": "0.1.0",
  "description": "Schema migrations for SQLite-backed Cloudflare Durable Objects. Raw SQL. No dependencies.",
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "durable-objects",
    "sqlite",
    "migrations",
    "schema"
  ],
  "homepage": "https://github.com/otar/durable-migrations#readme",
  "bugs": {
    "url": "https://github.com/otar/durable-migrations/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otar/durable-migrations.git"
  },
  "license": "MIT",
  "author": "Otar Chekurishvili",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:types": "tsc -p test/types && tsc -p test/types/tsconfig.nodenext.json && tsc -p test/types/tsconfig.exact.json && tsc -p test/types/tsconfig.standalone.json",
    "check:package": "node scripts/check-package.js"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261018.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
